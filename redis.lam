            }
            out = int(value)
        }
        return out
    }

    # Sets.
    func sadd(self, key: str, members: list[any]) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.SAdd(lamRedisContext(s._context), key, lamRedisArgs(members)...).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: SADD %s: %v", key, err))
            }
