    # Sorted sets.
    func zadd(self, key: str, score: float, member: any) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            item := rdb.Z{Score: score, Member: lamRedisToString(member)}
            count, err := c.ZAdd(lamRedisContext(s._context), key, item).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: ZADD %s: %v", key, err))
            }
            out = int(count)
        }
        return out
    }

    func zincrBy(self, key: str, by: float, member: any) -> float {
        out: float = 0.0
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.ZIncrBy(lamRedisContext(s._context), key, by, lamRedisToString(member)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: ZINCRBY %s: %v", key, err))
            }
            out = value
        }
        return out
    }

    func zscore(self, key: str, member: any) -> float {
        out: float = 0.0
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.ZScore(lamRedisContext(s._context), key, lamRedisToString(member)).Result()
            if err != nil {
                if !lamRedisIsNil(err) {
                    panic(fmt.Sprintf("redis: ZSCORE %s: %v", key, err))
                }
                return 0.0
            }
            out = value
        }
        return out
    }

    func zrange(self, key: str, start: int, stop: int) -> list[str] {
        out: list[str] = []
        go! {
            c := s._client.(*rdb.Client)
            values, err := c.ZRange(lamRedisContext(s._context), key, int64(start), int64(stop)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: ZRANGE %s: %v", key, err))
            }
            out = values
        }
        return out
    }

    func zrangeWithScores(self, key: str, start: int, stop: int) -> list[dict[str, any]] {
        out: list[dict[str, any]] = []
        go! {
            c := s._client.(*rdb.Client)
            values, err := c.ZRangeWithScores(lamRedisContext(s._context), key, int64(start), int64(stop)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: ZRANGE %s: %v", key, err))
            }
            for _, item := range values {
                row := map[string]interface{}{
                    "member": lamRedisToString(item.Member),
                    "score":  item.Score,
                }
                out = append(out, row)
            }
        }
        return out
    }

    func zrem(self, key: str, members: list[any]) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.ZRem(lamRedisContext(s._context), key, lamRedisArgs(members)...).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: ZREM %s: %v", key, err))
            }
            out = int(count)
        }
        return out
    }

    func zcard(self, key: str) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.ZCard(lamRedisContext(s._context), key).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: ZCARD %s: %v", key, err))
            }
            out = int(count)
        }
        return out
    }

    # Pub/Sub.
    func publish(self, channel: str, message: any) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.Publish(lamRedisContext(s._context), channel, lamRedisToString(message)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: PUBLISH %s: %v", channel, err))
            }
            out = int(count)
        }
        return out
    }

    func subscribe(self, channels: list[any]) -> PubSub {
        subscription: PubSub = PubSub()
        subscription._context = self._context.child()
        go! {
            c := s._client.(*rdb.Client)
            ctx := lamRedisContext(s._context)
            sub := c.Subscribe(ctx, lamRedisStrings(channels)...)
            if _, err := sub.Receive(ctx); err != nil {
                sub.Close()
                panic(fmt.Sprintf("redis: SUBSCRIBE: %v", err))
            }
            subscription._ps = sub
        }
        return subscription
    }

    func psubscribe(self, patterns: list[any]) -> PubSub {
        subscription: PubSub = PubSub()
        subscription._context = self._context.child()
        go! {
            c := s._client.(*rdb.Client)
            ctx := lamRedisContext(s._context)
            sub := c.PSubscribe(ctx, lamRedisStrings(patterns)...)
            if _, err := sub.Receive(ctx); err != nil {
                sub.Close()
                panic(fmt.Sprintf("redis: PSUBSCRIBE: %v", err))
            }
            subscription._ps = sub
        }
        return subscription
    }

    # Pipelines and utilities.
    func pipeline(self, commands: list[dict[str, any]]) -> list[any] {
        out: list[any] = []
        go! {
            c := s._client.(*rdb.Client)
            ctx := lamRedisContext(s._context)
            pipe := c.Pipeline()
            commanders := make([]rdb.Cmder, 0, len(commands))
            for _, command := range commands {
                name, _ := command["cmd"].(string)
                var args []interface{}
                if rawArgs, ok := command["args"].([]interface{}); ok {
                    args = lamRedisArgs(rawArgs)
                } else if stringArgs, ok := command["args"].([]string); ok {
                    args = make([]interface{}, len(stringArgs))
                    for index, value := range stringArgs {
                        args[index] = value
                    }
                }
                full := append([]interface{}{name}, args...)
                commanders = append(commanders, pipe.Do(ctx, full...))
            }
            _, _ = pipe.Exec(ctx)
            for _, commander := range commanders {
                if command, ok := commander.(*rdb.Cmd); ok {
                    if value, err := command.Result(); err == nil || lamRedisIsNil(err) {
                        out = append(out, value)
                    } else {
                        out = append(out, fmt.Sprintf("error: %v", err))
                    }
                }
            }
        }
        return out
    }

    func flushDb(self) {
        go! {
            c := s._client.(*rdb.Client)
            if err := c.FlushDB(lamRedisContext(s._context)).Err(); err != nil {
                panic(fmt.Sprintf("redis: FLUSHDB: %v", err))
            }
        }
    }

    func dbSize(self) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.DBSize(lamRedisContext(s._context)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: DBSIZE: %v", err))
            }
            out = int(count)
        }
        return out
    }
}
