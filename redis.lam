    # Pub/Sub.
    func publish(self, channel: str, message: any) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("PUBLISH "+channel, err)
            }
            count, err := client.Publish(ctx, channel, lamRedisToString(message)).Result()
            if err != nil {
                return lamRedisFailure("PUBLISH "+channel, err)
            }
            return LAMMERGEIER.Result.Ok(int(count))
        }
    }

    func subscribe(self, channels: list[str]) -> Result[PubSub] {
        if len(channels) == 0 {
            return Result.Err(Error("RedisArgumentError", "redis: subscribe requires at least one channel", None))
        }
        subscription: PubSub = PubSub()
        subscription._context = self._context.child()
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("SUBSCRIBE", err)
            }
            raw := client.Subscribe(ctx, lamRedisStrings(channels)...)
            if _, err = raw.Receive(ctx); err != nil {
                _ = raw.Close()
                return lamRedisFailure("SUBSCRIBE", err)
            }
            subscription._ps = raw
            return LAMMERGEIER.Result.Ok(subscription)
        }
    }

    func psubscribe(self, patterns: list[str]) -> Result[PubSub] {
        if len(patterns) == 0 {
            return Result.Err(Error("RedisArgumentError", "redis: psubscribe requires at least one pattern", None))
        }
        subscription: PubSub = PubSub()
        subscription._context = self._context.child()
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("PSUBSCRIBE", err)
            }
            raw := client.PSubscribe(ctx, lamRedisStrings(patterns)...)
            if _, err = raw.Receive(ctx); err != nil {
                _ = raw.Close()
                return lamRedisFailure("PSUBSCRIBE", err)
            }
            subscription._ps = raw
            return LAMMERGEIER.Result.Ok(subscription)
        }
    }

    # Pipelines and utilities.
    func pipeline(self, commands: list[RedisCommand]) -> Result[list[Result[any]]] {
        #- The outer Result reports pipeline setup/state failure. Each ordered
           inner Result reports that command's value, Redis error, transport
           failure, or RedisNotFound without stringifying errors. -#
        for command in commands {
            if command.name.trim() == "" {
                return Result.Err(Error("RedisArgumentError", "redis: pipeline command must not be empty", None))
            }
        }
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("PIPELINE", err)
            }
            pipe := client.Pipeline()
            queued := make([]*rdb.Cmd, 0, len(commands))
            for _, command := range commands {
                full := append([]interface{}{command.Name}, lamRedisArgs(command.Args)...)
                queued = append(queued, pipe.Do(ctx, full...))
            }
            _, _ = pipe.Exec(ctx)
            out := make([]*LAMMERGEIER.Result, 0, len(queued))
            for index, command := range queued {
                value, commandErr := command.Result()
                operation := fmt.Sprintf("PIPELINE[%d] %s", index, commands[index].Name)
                if lamRedisIsNil(commandErr) {
                    out = append(out, lamRedisMissing(operation))
                } else if commandErr != nil {
                    out = append(out, lamRedisFailure(operation, commandErr))
                } else {
                    out = append(out, LAMMERGEIER.Result.Ok(value))
                }
            }
            return LAMMERGEIER.Result.Ok(out)
        }
    }

    func flushDb(self) -> Result[bool] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("FLUSHDB", err)
            }
            if err = client.FlushDB(ctx).Err(); err != nil {
                return lamRedisFailure("FLUSHDB", err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

