# @lam/redis — Redis client for Lammergeier.
#
# Migrated from the Lammergeier lamredis stdlib module. The public PubSub and
# Redis APIs are preserved while command and subscription contexts use the
# lamcontext standard library instead of a duplicated raw Go context.

from lamcontext import Context

go! {
    import (
        "context"
        "encoding/json"
        "errors"
        "fmt"
        "strconv"
        "time"

        rdb "github.com/redis/go-redis/v9"
    )

    func lamRedisToString(v interface{}) string {
        switch x := v.(type) {
        case nil:
            return ""
        case string:
            return x
        case []byte:
            return string(x)
        case bool:
            if x {
                return "1"
            }
            return "0"
        case int:
            return strconv.Itoa(x)
        case int64:
            return strconv.FormatInt(x, 10)
        case float64:
            return strconv.FormatFloat(x, 'g', -1, 64)
        default:
            return fmt.Sprintf("%v", x)
        }
    }

    func lamRedisArgs(values []interface{}) []interface{} {
        out := make([]interface{}, 0, len(values))
        for _, v := range values {
            out = append(out, lamRedisToString(v))
        }
        return out
    }

    func lamRedisStrings(values []interface{}) []string {
        out := make([]string, len(values))
        for i, v := range values {
            out[i] = lamRedisToString(v)
        }
        return out
    }

    func lamRedisIsNil(err error) bool {
        return errors.Is(err, rdb.Nil)
    }

    func lamRedisContext(value *Context) context.Context {
        if value == nil {
            panic("redis: missing command context")
        }
        native, ok := value.Native().(context.Context)
        if !ok || native == nil {
            panic("redis: invalid command context")
        }
        return native
    }
}

class PubSub {
    #- Blocking iterator returned by Redis.subscribe and Redis.psubscribe. -#

    func __init__(self) {
        self._ps: any = None
        self._context: Context = Context.simple()
        self._timeoutMs: int = 0
    }

    func setTimeout(self, ms: int) {
        #- Limit each next/nextWith wait to ms milliseconds; 0 waits forever. -#
        self._timeoutMs = ms
    }

    func next(self) -> str {
        #- Return the next payload, or "" after timeout/close/cancellation. -#
        out: str = ""
        waitContext: Context = self._context.child()
        if self._timeoutMs > 0 {
            waitContext = self._context.expirable(self._timeoutMs, "milliseconds")
        }
        go! {
            defer waitContext.Cancel("redis pubsub wait complete")
            ps, _ := s._ps.(*rdb.PubSub)
            if ps == nil {
                return ""
            }
            msg, err := ps.ReceiveMessage(lamRedisContext(waitContext))
            if err != nil {
                return ""
            }
            out = msg.Payload
        }
        return out
    }

    func nextWith(self) -> dict[str, str] {
        #- Return channel, pattern, and payload for the next message. -#
        out: dict[str, str] = {}
        waitContext: Context = self._context.child()
        if self._timeoutMs > 0 {
            waitContext = self._context.expirable(self._timeoutMs, "milliseconds")
        }
        go! {
            defer waitContext.Cancel("redis pubsub wait complete")
            ps, _ := s._ps.(*rdb.PubSub)
            if ps == nil {
                return nil
            }
            msg, err := ps.ReceiveMessage(lamRedisContext(waitContext))
            if err != nil {
                return nil
            }
            out["channel"] = msg.Channel
            out["pattern"] = msg.Pattern
            out["payload"] = msg.Payload
        }
        return out
    }

    func close(self) {
        #- Stop the subscription and release its connection. Idempotent. -#
        go! {
            if ps, ok := s._ps.(*rdb.PubSub); ok && ps != nil {
                ps.Close()
            }
            s._ps = nil
        }
        self._context.cancel("redis pubsub closed")
    }
}

class Redis {
    #- Thread-safe Redis client backed by go-redis's connection pool. -#

    func __init__(self) {
        self._client: any = None
        self._context: Context = Context.simple()
    }

    static func connect(addr: str, password: str = "", db: int = 0, username: str = "") -> Redis {
        #- Connect to host:port, optionally using password, ACL username, and DB. -#
        redis: Redis = Redis()
        go! {
            redis._client = rdb.NewClient(&rdb.Options{
                Addr:     addr,
                Username: username,
                Password: password,
                DB:       db,
            })
        }
        _ = redis.ping()
        return redis
    }

    static func fromUrl(url_: str) -> Redis {
        #- Parse redis:// or rediss:// connection configuration. -#
        redis: Redis = Redis()
        go! {
            opts, err := rdb.ParseURL(url_)
            if err != nil {
                panic(fmt.Sprintf("redis: invalid URL %q: %v", url_, err))
            }
            redis._client = rdb.NewClient(opts)
        }
        _ = redis.ping()
        return redis
    }

    func close(self) {
        #- Close the connection pool. Idempotent. -#
        go! {
            if c, ok := s._client.(*rdb.Client); ok && c != nil {
                c.Close()
            }
            s._client = nil
        }
        self._context.cancel("redis client closed")
    }

    # Generic commands and health.
    func ping(self) -> str {
        out: str = ""
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.Ping(lamRedisContext(s._context)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: ping: %v", err))
            }
            out = value
        }
        return out
    }

    func exec(self, cmd: str, args: list[any]) -> any {
        #- Execute an arbitrary Redis command. -#
        out: any = None
        go! {
            c := s._client.(*rdb.Client)
            full := append([]interface{}{cmd}, lamRedisArgs(args)...)
            result, err := c.Do(lamRedisContext(s._context), full...).Result()
            if err != nil && !lamRedisIsNil(err) {
                panic(fmt.Sprintf("redis: %s: %v", cmd, err))
            }
            out = result
        }
        return out
    }

    # Strings and key lifecycle.
    func set(self, key: str, value: any, ttlSec: int = 0) {
        go! {
            c := s._client.(*rdb.Client)
            duration := time.Duration(0)
            if ttlSec > 0 {
                duration = time.Duration(ttlSec) * time.Second
            }
            if err := c.Set(lamRedisContext(s._context), key, lamRedisToString(value), duration).Err(); err != nil {
                panic(fmt.Sprintf("redis: SET %s: %v", key, err))
            }
        }
    }

    func setNx(self, key: str, value: any, ttlSec: int = 0) -> bool {
        ok: bool = false
        go! {
            c := s._client.(*rdb.Client)
            duration := time.Duration(0)
            if ttlSec > 0 {
                duration = time.Duration(ttlSec) * time.Second
            }
            result, err := c.SetNX(lamRedisContext(s._context), key, lamRedisToString(value), duration).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: SETNX %s: %v", key, err))
            }
            ok = result
        }
        return ok
    }

    func get(self, key: str) -> str {
        out: str = ""
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.Get(lamRedisContext(s._context), key).Result()
            if err != nil {
                if !lamRedisIsNil(err) {
                    panic(fmt.Sprintf("redis: GET %s: %v", key, err))
                }
                return ""
            }
            out = value
        }
        return out
    }

    func setJson(self, key: str, value: json, ttlSec: int = 0) {
        go! {
            c := s._client.(*rdb.Client)
            encoded, err := json.Marshal(value)
            if err != nil {
                panic(fmt.Sprintf("redis: JSON encode %s: %v", key, err))
            }
            duration := time.Duration(0)
            if ttlSec > 0 {
                duration = time.Duration(ttlSec) * time.Second
            }
            if err := c.Set(lamRedisContext(s._context), key, string(encoded), duration).Err(); err != nil {
                panic(fmt.Sprintf("redis: SET JSON %s: %v", key, err))
            }
        }
    }

    func getJson(self, key: str) -> json {
        go! {
            c := s._client.(*rdb.Client)
            encoded, err := c.Get(lamRedisContext(s._context), key).Result()
            if err != nil {
                if lamRedisIsNil(err) {
                    return lamJSONMust(nil)
                }
                panic(fmt.Sprintf("redis: GET JSON %s: %v", key, err))
            }
            parsed, parseErr := lamJSONParse(encoded)
            if parseErr != nil {
                panic(fmt.Sprintf("redis: invalid JSON at %s: %v", key, parseErr))
            }
            return parsed
        }
    }

    func getDel(self, key: str) -> str {
        out: str = ""
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.GetDel(lamRedisContext(s._context), key).Result()
            if err != nil {
                if !lamRedisIsNil(err) {
                    panic(fmt.Sprintf("redis: GETDEL %s: %v", key, err))
                }
                return ""
            }
            out = value
        }
        return out
    }

    func mset(self, pairs: dict[str, any]) {
        go! {
            c := s._client.(*rdb.Client)
            args := make([]interface{}, 0, len(pairs)*2)
            for key, value := range pairs {
                args = append(args, key, lamRedisToString(value))
            }
            if err := c.MSet(lamRedisContext(s._context), args...).Err(); err != nil {
                panic(fmt.Sprintf("redis: MSET: %v", err))
            }
        }
    }

    func mget(self, keys: list[any]) -> list[str] {
        out: list[str] = []
        go! {
            c := s._client.(*rdb.Client)
            values, err := c.MGet(lamRedisContext(s._context), lamRedisStrings(keys)...).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: MGET: %v", err))
            }
            for _, value := range values {
                if value == nil {
                    out = append(out, "")
                } else {
                    out = append(out, lamRedisToString(value))
                }
            }
        }
        return out
    }

    func exists(self, keys: list[any]) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.Exists(lamRedisContext(s._context), lamRedisStrings(keys)...).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: EXISTS: %v", err))
            }
            out = int(count)
        }
        return out
    }

    func delete(self, keys: list[any]) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.Del(lamRedisContext(s._context), lamRedisStrings(keys)...).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: DEL: %v", err))
            }
            out = int(count)
        }
        return out
    }

    func expire(self, key: str, ttlSec: int) -> bool {
        ok: bool = false
        go! {
            c := s._client.(*rdb.Client)
            result, err := c.Expire(lamRedisContext(s._context), key, time.Duration(ttlSec)*time.Second).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: EXPIRE %s: %v", key, err))
            }
            ok = result
        }
        return ok
    }

    func persist(self, key: str) -> bool {
        ok: bool = false
        go! {
            c := s._client.(*rdb.Client)
            result, err := c.Persist(lamRedisContext(s._context), key).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: PERSIST %s: %v", key, err))
            }
            ok = result
        }
        return ok
    }

    func ttl(self, key: str) -> int {
        out: int = - 2
        go! {
            c := s._client.(*rdb.Client)
            duration, err := c.TTL(lamRedisContext(s._context), key).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: TTL %s: %v", key, err))
            }
            switch duration {
            case time.Duration(-1):
                out = -1
            case time.Duration(-2):
                out = -2
            default:
                out = int(duration / time.Second)
            }
        }
        return out
    }

    func type_(self, key: str) -> str {
        out: str = ""
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.Type(lamRedisContext(s._context), key).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: TYPE %s: %v", key, err))
            }
            out = value
        }
        return out
    }

    func keys(self, pattern: str) -> list[str] {
        out: list[str] = []
        go! {
            c := s._client.(*rdb.Client)
            values, err := c.Keys(lamRedisContext(s._context), pattern).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: KEYS %s: %v", pattern, err))
            }
            out = values
        }
        return out
    }

    func scan(self, cursor: int, match: str = "", count: int = 0) -> dict[str, any] {
        next: int = 0
        keys: list[str] = []
        go! {
            c := s._client.(*rdb.Client)
            values, nextCursor, err := c.Scan(lamRedisContext(s._context), uint64(cursor), match, int64(count)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: SCAN: %v", err))
            }
            keys = values
            next = int(nextCursor)
        }
        out: dict[str, any] = {}
        out["cursor"] = next
        out["keys"] = keys
        return out
    }

    # Counters.
    func incr(self, key: str) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.Incr(lamRedisContext(s._context), key).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: INCR %s: %v", key, err))
            }
            out = int(value)
        }
        return out
    }

    func incrBy(self, key: str, by: int) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.IncrBy(lamRedisContext(s._context), key, int64(by)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: INCRBY %s: %v", key, err))
            }
            out = int(value)
        }
        return out
    }

    func decr(self, key: str) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.Decr(lamRedisContext(s._context), key).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: DECR %s: %v", key, err))
            }
            out = int(value)
        }
        return out
    }

    func decrBy(self, key: str, by: int) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.DecrBy(lamRedisContext(s._context), key, int64(by)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: DECRBY %s: %v", key, err))
            }
            out = int(value)
        }
        return out
    }

    # Lists.
    func lpush(self, key: str, values: list[any]) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.LPush(lamRedisContext(s._context), key, lamRedisArgs(values)...).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: LPUSH %s: %v", key, err))
            }
            out = int(count)
        }
        return out
    }

    func rpush(self, key: str, values: list[any]) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.RPush(lamRedisContext(s._context), key, lamRedisArgs(values)...).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: RPUSH %s: %v", key, err))
            }
            out = int(count)
        }
        return out
    }

    func lpop(self, key: str) -> str {
        out: str = ""
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.LPop(lamRedisContext(s._context), key).Result()
            if err != nil {
                if !lamRedisIsNil(err) {
                    panic(fmt.Sprintf("redis: LPOP %s: %v", key, err))
                }
                return ""
            }
            out = value
        }
        return out
    }

    func rpop(self, key: str) -> str {
        out: str = ""
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.RPop(lamRedisContext(s._context), key).Result()
            if err != nil {
                if !lamRedisIsNil(err) {
                    panic(fmt.Sprintf("redis: RPOP %s: %v", key, err))
                }
                return ""
            }
            out = value
        }
        return out
    }

    func llen(self, key: str) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.LLen(lamRedisContext(s._context), key).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: LLEN %s: %v", key, err))
            }
            out = int(count)
        }
        return out
    }

    func lrange(self, key: str, start: int, stop: int) -> list[str] {
        out: list[str] = []
        go! {
            c := s._client.(*rdb.Client)
            values, err := c.LRange(lamRedisContext(s._context), key, int64(start), int64(stop)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: LRANGE %s: %v", key, err))
            }
            out = values
        }
        return out
    }

    # Hashes.
    func hset(self, key: str, field: str, value: any) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.HSet(lamRedisContext(s._context), key, field, lamRedisToString(value)).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: HSET %s: %v", key, err))
            }
            out = int(count)
        }
        return out
    }

    func hsetMap(self, key: str, fields: dict[str, any]) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            args := make([]interface{}, 0, len(fields)*2)
            for field, value := range fields {
                args = append(args, field, lamRedisToString(value))
            }
            count, err := c.HSet(lamRedisContext(s._context), key, args...).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: HSET %s: %v", key, err))
            }
            out = int(count)
        }
        return out
    }

    func hget(self, key: str, field: str) -> str {
        out: str = ""
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.HGet(lamRedisContext(s._context), key, field).Result()
            if err != nil {
                if !lamRedisIsNil(err) {
                    panic(fmt.Sprintf("redis: HGET %s.%s: %v", key, field, err))
                }
                return ""
            }
            out = value
        }
        return out
    }

    func hgetAll(self, key: str) -> dict[str, str] {
        out: dict[str, str] = {}
        go! {
            c := s._client.(*rdb.Client)
            values, err := c.HGetAll(lamRedisContext(s._context), key).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: HGETALL %s: %v", key, err))
            }
            for field, value := range values {
                out[field] = value
            }
        }
        return out
    }

    func hdel(self, key: str, fields: list[any]) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            count, err := c.HDel(lamRedisContext(s._context), key, lamRedisStrings(fields)...).Result()
            if err != nil {
                panic(fmt.Sprintf("redis: HDEL %s: %v", key, err))
            }
