# @lam/redis — Result-first Redis client for Lammergeier.

from lamcontext import Context
from lamerrors import Error, Result

# Raw Go is intentionally limited to context unwrapping and go-redis calls.
go! {
    import (
        "context"
        "encoding/json"
        "errors"
        "fmt"
        "strconv"
        "time"

        rdb "github.com/redis/go-redis/v9"
    )

    func lamRedisToString(value interface{}) string {
        switch typed := value.(type) {
        case nil:
            return ""
        case string:
            return typed
        case []byte:
            return string(typed)
        case bool:
            if typed {
                return "1"
            }
            return "0"
        case int:
            return strconv.Itoa(typed)
        case int64:
            return strconv.FormatInt(typed, 10)
        case float64:
            return strconv.FormatFloat(typed, 'g', -1, 64)
        default:
            return fmt.Sprintf("%v", typed)
        }
    }

    func lamRedisArgs(values []interface{}) []interface{} {
        out := make([]interface{}, 0, len(values))
        for _, value := range values {
            out = append(out, lamRedisToString(value))
        }
        return out
    }

    func lamRedisStrings(values []string) []string {
        return append([]string(nil), values...)
    }

    func lamRedisIsNil(err error) bool {
        return errors.Is(err, rdb.Nil)
    }

    func lamRedisContext(value *Context) (context.Context, error) {
        if value == nil {
            return nil, errors.New("missing command context")
        }
        native, ok := value.Native().(context.Context)
        if !ok || native == nil {
            return nil, errors.New("invalid command context")
        }
        return native, nil
    }

    func lamRedisState(raw interface{}, value *Context) (*rdb.Client, context.Context, error) {
        client, ok := raw.(*rdb.Client)
        if !ok || client == nil {
            return nil, nil, errors.New("client is closed")
        }
        ctx, err := lamRedisContext(value)
        if err != nil {
            return nil, nil, err
        }
        return client, ctx, nil
    }

    func lamRedisFailure(operation string, err error) *LAMMERGEIER.Result {
        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
            "RedisError", fmt.Sprintf("redis: %s: %v", operation, err), nil,
        ))
    }

    func lamRedisMissing(operation string) *LAMMERGEIER.Result {
        return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
            "RedisNotFound", fmt.Sprintf("redis: %s: value not found", operation), nil,
        ))
    }

    func lamRedisReceiveFailure(operation string, ctx context.Context, err error) *LAMMERGEIER.Result {
        if errors.Is(ctx.Err(), context.DeadlineExceeded) {
            return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                "RedisTimeout", fmt.Sprintf("redis: %s: timed out", operation), nil,
            ))
        }
        if errors.Is(ctx.Err(), context.Canceled) {
            return LAMMERGEIER.Result.Err(LAMMERGEIER.Error(
                "RedisClosed", fmt.Sprintf("redis: %s: subscription is closed", operation), nil,
            ))
        }
        return lamRedisFailure(operation, err)
    }
}

class RedisCommand {
    #- One arbitrary command in a pipeline. args intentionally uses any because
       Redis commands accept heterogeneous protocol values. -#

    func init(self, name: str, args: list[any] = []) {
        self.name: str = name
        self.args: list[any] = args
    }
}

class RedisScanPage {
    func init(self, cursor: int, keys: list[str]) {
        self.cursor: int = cursor
        self.keys: list[str] = keys
    }
}

class RedisZMember {
    func init(self, member: str, score: float) {
        self.member: str = member
        self.score: float = score
    }
}

class PubSub {
    #- Blocking Result-first iterator returned by subscribe and psubscribe. -#

    func init(self) {
        self._ps: any = None
        self._context: Context = Context.simple()
        self._timeoutMs: int = 0
        self._closed: bool = false
    }

    func setTimeout(self, ms: int) -> Result[bool] {
        if ms < 0 {
            return Result.Err(Error("RedisArgumentError", "redis: PubSub timeout cannot be negative", None))
        }
        self._timeoutMs = ms
        return Result.Ok(true)
    }

    func next(self) -> Result[str] {
        #- Return the next payload. Timeout, closure, cancellation, and receive
           failures are explicit errors rather than an empty-string sentinel. -#
        if self._closed {
            return Result.Err(Error("RedisClosed", "redis: PubSub.next: subscription is closed", None))
        }
        waitContext: Context = self._context.child()
        if self._timeoutMs > 0 {
            waitContext = self._context.expirable(self._timeoutMs, "milliseconds")?
        }
        go! {
            defer waitContext.Cancel("redis pubsub wait complete")
            subscription, ok := s._ps.(*rdb.PubSub)
            if !ok || subscription == nil {
                return lamRedisFailure("PubSub.next", errors.New("subscription is not initialized"))
            }
            ctx, contextErr := lamRedisContext(waitContext)
            if contextErr != nil {
                return lamRedisFailure("PubSub.next", contextErr)
            }
            message, err := subscription.ReceiveMessage(ctx)
            if err != nil {
                return lamRedisReceiveFailure("PubSub.next", ctx, err)
            }
            return LAMMERGEIER.Result.Ok(message.Payload)
        }
    }

    func nextWith(self) -> Result[dict[str, str]] {
        #- Return channel, pattern, and payload for the next message. -#
        if self._closed {
            return Result.Err(Error("RedisClosed", "redis: PubSub.nextWith: subscription is closed", None))
        }
        waitContext: Context = self._context.child()
        if self._timeoutMs > 0 {
            waitContext = self._context.expirable(self._timeoutMs, "milliseconds")?
        }
        go! {
            defer waitContext.Cancel("redis pubsub wait complete")
            subscription, ok := s._ps.(*rdb.PubSub)
            if !ok || subscription == nil {
                return lamRedisFailure("PubSub.nextWith", errors.New("subscription is not initialized"))
            }
            ctx, contextErr := lamRedisContext(waitContext)
            if contextErr != nil {
                return lamRedisFailure("PubSub.nextWith", contextErr)
            }
            message, err := subscription.ReceiveMessage(ctx)
            if err != nil {
                return lamRedisReceiveFailure("PubSub.nextWith", ctx, err)
            }
            return LAMMERGEIER.Result.Ok(map[string]string{
                "channel": message.Channel,
                "pattern": message.Pattern,
                "payload": message.Payload,
            })
        }
    }

    func close(self) -> Result[any] {
        if self._closed {
            return Result.Ok(None)
        }
        self._closed = true
        self._context.cancel("redis pubsub closed")
        go! {
            subscription, _ := s._ps.(*rdb.PubSub)
            if subscription != nil {
                if err := subscription.Close(); err != nil {
                    return lamRedisFailure("PubSub.close", err)
                }
            }
            s._ps = nil
            return LAMMERGEIER.Result.Ok(nil)
        }
    }
}

class Redis {
    #- Thread-safe Redis client backed by go-redis's connection pool. All
       service, transport, parse, and wrong-type failures return Result. -#

    func init(self) {
        self._client: any = None
        self._context: Context = Context.simple()
        self._closed: bool = false
    }

    static func connect(addr: str, password: str = "", db: int = 0, username: str = "") -> Result[Redis] {
        #- Create a client and eagerly PING it. -#
        if addr.trim() == "" {
            return Result.Err(Error("RedisArgumentError", "redis: address must not be empty", None))
        }
        if db < 0 {
            return Result.Err(Error("RedisArgumentError", "redis: database number cannot be negative", None))
        }
        redis: Redis = Redis()
        go! {
            client := rdb.NewClient(&rdb.Options{
                Addr: addr, Username: username, Password: password, DB: db,
            })
            ctx, contextErr := lamRedisContext(redis._context)
            if contextErr != nil {
                _ = client.Close()
                return lamRedisFailure("connect", contextErr)
            }
            if err := client.Ping(ctx).Err(); err != nil {
                _ = client.Close()
                return lamRedisFailure("connect", err)
            }
            redis._client = client
            return LAMMERGEIER.Result.Ok(redis)
        }
    }

    static func fromUrl(url_: str) -> Result[Redis] {
        #- Parse redis:// or rediss:// configuration and eagerly PING it. -#
        redis: Redis = Redis()
        go! {
            options, err := rdb.ParseURL(url_)
            if err != nil {
                return lamRedisFailure("parse URL", err)
            }
            client := rdb.NewClient(options)
            ctx, contextErr := lamRedisContext(redis._context)
            if contextErr != nil {
                _ = client.Close()
                return lamRedisFailure("connect URL", contextErr)
            }
            if err = client.Ping(ctx).Err(); err != nil {
                _ = client.Close()
                return lamRedisFailure("connect URL", err)
            }
            redis._client = client
            return LAMMERGEIER.Result.Ok(redis)
        }
    }

    func close(self) -> Result[any] {
        if self._closed {
            return Result.Ok(None)
        }
        self._closed = true
        self._context.cancel("redis client closed")
        go! {
            client, _ := s._client.(*rdb.Client)
            if client != nil {
                if err := client.Close(); err != nil {
                    return lamRedisFailure("close", err)
                }
            }
            s._client = nil
            return LAMMERGEIER.Result.Ok(nil)
        }
    }

    # Generic commands and health.
    func ping(self) -> Result[str] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("PING", err)
            }
            value, err := client.Ping(ctx).Result()
            if err != nil {
                return lamRedisFailure("PING", err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func exec(self, command: str, args: list[any] = []) -> Result[any] {
        #- Execute an arbitrary command. any is required for heterogeneous
           command arguments and protocol-dependent response values. -#
        if command.trim() == "" {
            return Result.Err(Error("RedisArgumentError", "redis: command must not be empty", None))
        }
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure(command, err)
            }
            full := append([]interface{}{command}, lamRedisArgs(args)...)
            value, err := client.Do(ctx, full...).Result()
            if lamRedisIsNil(err) {
                return lamRedisMissing(command)
            }
            if err != nil {
                return lamRedisFailure(command, err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    # Strings and key lifecycle.
    func set(self, key: str, value: any, ttlSec: int = 0) -> Result[bool] {
        if ttlSec < 0 {
            return Result.Err(Error("RedisArgumentError", "redis: ttlSec cannot be negative", None))
        }
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("SET "+key, err)
            }
            duration := time.Duration(ttlSec) * time.Second
            if err = client.Set(ctx, key, lamRedisToString(value), duration).Err(); err != nil {
                return lamRedisFailure("SET "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func setNx(self, key: str, value: any, ttlSec: int = 0) -> Result[bool] {
        if ttlSec < 0 {
            return Result.Err(Error("RedisArgumentError", "redis: ttlSec cannot be negative", None))
        }
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("SETNX "+key, err)
            }
            result, err := client.SetNX(ctx, key, lamRedisToString(value), time.Duration(ttlSec)*time.Second).Result()
            if err != nil {
                return lamRedisFailure("SETNX "+key, err)
            }
            return LAMMERGEIER.Result.Ok(result)
        }
    }

    func get(self, key: str) -> Result[str] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("GET "+key, err)
            }
            value, err := client.Get(ctx, key).Result()
            if lamRedisIsNil(err) {
                return lamRedisMissing("GET " + key)
            }
            if err != nil {
                return lamRedisFailure("GET "+key, err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func setJson(self, key: str, value: json, ttlSec: int = 0) -> Result[bool] {
        if ttlSec < 0 {
            return Result.Err(Error("RedisArgumentError", "redis: ttlSec cannot be negative", None))
        }
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("SET JSON "+key, err)
            }
            encoded, err := json.Marshal(value)
            if err != nil {
                return lamRedisFailure("encode JSON "+key, err)
            }
            if err = client.Set(ctx, key, string(encoded), time.Duration(ttlSec)*time.Second).Err(); err != nil {
                return lamRedisFailure("SET JSON "+key, err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func getJson(self, key: str) -> Result[json] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("GET JSON "+key, err)
            }
            encoded, err := client.Get(ctx, key).Result()
            if lamRedisIsNil(err) {
                return lamRedisMissing("GET JSON " + key)
            }
            if err != nil {
                return lamRedisFailure("GET JSON "+key, err)
            }
            parsed, err := lamJSONParse(encoded)
            if err != nil {
                return lamRedisFailure("decode JSON "+key, err)
            }
            return LAMMERGEIER.Result.Ok(parsed)
        }
    }

    func getDel(self, key: str) -> Result[str] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("GETDEL "+key, err)
            }
            value, err := client.GetDel(ctx, key).Result()
            if lamRedisIsNil(err) {
                return lamRedisMissing("GETDEL " + key)
            }
            if err != nil {
                return lamRedisFailure("GETDEL "+key, err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func mset(self, pairs: dict[str, any]) -> Result[bool] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("MSET", err)
            }
            args := make([]interface{}, 0, len(pairs)*2)
            for key, value := range pairs {
                args = append(args, key, lamRedisToString(value))
            }
            if err = client.MSet(ctx, args...).Err(); err != nil {
                return lamRedisFailure("MSET", err)
            }
            return LAMMERGEIER.Result.Ok(true)
        }
    }

    func mget(self, keys: list[str]) -> Result[list[Result[str]]] {
        #- The outer Result covers the command; each item Result preserves
           missing-value information without conflating it with an empty string. -#
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("MGET", err)
            }
            values, err := client.MGet(ctx, lamRedisStrings(keys)...).Result()
            if err != nil {
                return lamRedisFailure("MGET", err)
            }
            out := make([]*LAMMERGEIER.Result, 0, len(values))
            for index, value := range values {
                if value == nil {
                    out = append(out, lamRedisMissing(fmt.Sprintf("MGET %s", keys[index])))
                } else {
                    out = append(out, LAMMERGEIER.Result.Ok(lamRedisToString(value)))
                }
            }
            return LAMMERGEIER.Result.Ok(out)
        }
    }

    func exists(self, keys: list[str]) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("EXISTS", err)
            }
            count, err := client.Exists(ctx, lamRedisStrings(keys)...).Result()
            if err != nil {
                return lamRedisFailure("EXISTS", err)
            }
            return LAMMERGEIER.Result.Ok(int(count))
        }
    }

    func delete(self, keys: list[str]) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("DEL", err)
            }
            count, err := client.Del(ctx, lamRedisStrings(keys)...).Result()
            if err != nil {
                return lamRedisFailure("DEL", err)
            }
            return LAMMERGEIER.Result.Ok(int(count))
        }
    }

    func expire(self, key: str, ttlSec: int) -> Result[bool] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("EXPIRE "+key, err)
            }
            value, err := client.Expire(ctx, key, time.Duration(ttlSec)*time.Second).Result()
            if err != nil {
                return lamRedisFailure("EXPIRE "+key, err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func persist(self, key: str) -> Result[bool] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("PERSIST "+key, err)
            }
            value, err := client.Persist(ctx, key).Result()
            if err != nil {
                return lamRedisFailure("PERSIST "+key, err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func ttl(self, key: str) -> Result[int] {
        #- Ok(-1) means persistent; a missing key is RedisNotFound. -#
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("TTL "+key, err)
            }
            duration, err := client.TTL(ctx, key).Result()
            if err != nil {
                return lamRedisFailure("TTL "+key, err)
            }
            if duration == time.Duration(-2) {
                return lamRedisMissing("TTL " + key)
            }
            if duration == time.Duration(-1) {
                return LAMMERGEIER.Result.Ok(-1)
            }
            return LAMMERGEIER.Result.Ok(int(duration / time.Second))
        }
    }

    func type_(self, key: str) -> Result[str] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("TYPE "+key, err)
            }
            value, err := client.Type(ctx, key).Result()
            if err != nil {
                return lamRedisFailure("TYPE "+key, err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func keys(self, pattern: str) -> Result[list[str]] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("KEYS "+pattern, err)
            }
            values, err := client.Keys(ctx, pattern).Result()
            if err != nil {
                return lamRedisFailure("KEYS "+pattern, err)
            }
            return LAMMERGEIER.Result.Ok(values)
        }
    }

    func scan(self, cursor: int, match: str = "", count: int = 0) -> Result[RedisScanPage] {
        if cursor < 0 or count < 0 {
            return Result.Err(Error("RedisArgumentError", "redis: scan cursor and count cannot be negative", None))
        }
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("SCAN", err)
            }
            values, next, err := client.Scan(ctx, uint64(cursor), match, int64(count)).Result()
            if err != nil {
                return lamRedisFailure("SCAN", err)
            }
            return LAMMERGEIER.Result.Ok(NewRedisScanPage(int(next), values))
        }
    }

    # Counters.
    func incr(self, key: str) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("INCR "+key, err)
            }
            value, err := client.Incr(ctx, key).Result()
            if err != nil {
                return lamRedisFailure("INCR "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(value))
        }
    }

    func incrBy(self, key: str, by: int) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("INCRBY "+key, err)
            }
            value, err := client.IncrBy(ctx, key, int64(by)).Result()
            if err != nil {
                return lamRedisFailure("INCRBY "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(value))
        }
    }

    func decr(self, key: str) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("DECR "+key, err)
            }
            value, err := client.Decr(ctx, key).Result()
            if err != nil {
                return lamRedisFailure("DECR "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(value))
        }
    }

    func decrBy(self, key: str, by: int) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("DECRBY "+key, err)
            }
            value, err := client.DecrBy(ctx, key, int64(by)).Result()
            if err != nil {
                return lamRedisFailure("DECRBY "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(value))
        }
    }

    # Lists.
    func lpush(self, key: str, values: list[any]) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("LPUSH "+key, err)
            }
            count, err := client.LPush(ctx, key, lamRedisArgs(values)...).Result()
            if err != nil {
                return lamRedisFailure("LPUSH "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(count))
        }
    }

    func rpush(self, key: str, values: list[any]) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("RPUSH "+key, err)
            }
            count, err := client.RPush(ctx, key, lamRedisArgs(values)...).Result()
            if err != nil {
                return lamRedisFailure("RPUSH "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(count))
        }
    }

    func lpop(self, key: str) -> Result[str] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("LPOP "+key, err)
            }
            value, err := client.LPop(ctx, key).Result()
            if lamRedisIsNil(err) {
                return lamRedisMissing("LPOP " + key)
            }
            if err != nil {
                return lamRedisFailure("LPOP "+key, err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func rpop(self, key: str) -> Result[str] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("RPOP "+key, err)
            }
            value, err := client.RPop(ctx, key).Result()
            if lamRedisIsNil(err) {
                return lamRedisMissing("RPOP " + key)
            }
            if err != nil {
                return lamRedisFailure("RPOP "+key, err)
            }
            return LAMMERGEIER.Result.Ok(value)
        }
    }

    func llen(self, key: str) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("LLEN "+key, err)
            }
            value, err := client.LLen(ctx, key).Result()
            if err != nil {
                return lamRedisFailure("LLEN "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(value))
        }
    }

    func lrange(self, key: str, start: int, stop: int) -> Result[list[str]] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("LRANGE "+key, err)
            }
            values, err := client.LRange(ctx, key, int64(start), int64(stop)).Result()
            if err != nil {
                return lamRedisFailure("LRANGE "+key, err)
            }
            return LAMMERGEIER.Result.Ok(values)
        }
    }

    # Hashes. hset is overloaded for one field or a map of fields.
    func hset(self, key: str, field: str, value: any) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("HSET "+key, err)
            }
            count, err := client.HSet(ctx, key, field, lamRedisToString(value)).Result()
            if err != nil {
                return lamRedisFailure("HSET "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(count))
        }
    }

    func hset(self, key: str, fields: dict[str, any]) -> Result[int] {
        go! {
            client, ctx, err := lamRedisState(s._client, s._context)
            if err != nil {
                return lamRedisFailure("HSET "+key, err)
            }
            args := make([]interface{}, 0, len(fields)*2)
            for field, value := range fields {
                args = append(args, field, lamRedisToString(value))
            }
            count, err := client.HSet(ctx, key, args...).Result()
            if err != nil {
                return lamRedisFailure("HSET "+key, err)
            }
            return LAMMERGEIER.Result.Ok(int(count))
        }
    }

    func hget(self, key: str, field: str) -> Result[str] {
