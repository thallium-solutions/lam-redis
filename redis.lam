    func hincrBy(self, key: str, field: str, by: int) -> int {
        out: int = 0
        go! {
            c := s._client.(*rdb.Client)
            value, err := c.HIncrBy(lamRedisContext(s._context), key, field, int64(by)).Result()
            if err != nil {
