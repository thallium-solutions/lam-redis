# expect: redis-json:Ada:2
# expect: object
# expect: missing-json-error:true

from @lam/redis import Redis
from lamerrors import Result
from lamjson import Json

func run() -> Result[bool] {
    redis: Redis = Redis.connect("localhost:6379", password = "Password")?
    _ = redis.delete(["lam:native:json"])?
    payload: json = {"name": "Ada", "roles": ["admin", "writer"]}
    _ = redis.setJson("lam:native:json", payload, 30)?

    restoredValue: any = redis.getJson("lam:native:json")?
    restored: json = Json.fromValue(restoredValue)?
    name: str = restored.name
    count: int = len(restored.roles)
    print(f"redis-json:{name}:{count}")
    print(Json.kind(restored))

    _ = redis.delete(["lam:native:json"])?
    missing: Result[json] = redis.getJson("lam:native:json")
    print("missing-json-error:" + str(not missing.ok()))
    _ = redis.close()?
    return Result.Ok(true)
}

func main() {
    _ = run().unwrap()
}
